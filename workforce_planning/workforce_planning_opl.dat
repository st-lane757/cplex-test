demand = 
  <
    < <1,1,0>, <1,0,0> >, // Mon: Day requires Weld=1,Fit=1,Test=0; Night requires Weld=1
    < <1,1,1>, <1,0,1> >, // Tue
    < <1,1,0>, <1,1,1> >  // Wed
  >;

// hasSkill[worker][skill]
